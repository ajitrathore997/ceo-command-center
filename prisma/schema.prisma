generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CEO
  STAFF
}

enum DealStatus {
  ACTIVE
  WON
  LOST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Department {
  SALES
  OPERATIONS
  FINANCE
  MARKETING
  HR
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  ACTIVE
  PAUSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CEO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  salesDeals   Deal[]   @relation("SalespersonDeals")
}

model Deal {
  id            String     @id @default(cuid())
  title         String
  value         Decimal    @db.Decimal(12, 2)
  status        DealStatus @default(ACTIVE)
  salespersonId String
  createdAt     DateTime   @default(now())
  closedAt      DateTime?
  salesperson   User       @relation("SalespersonDeals", fields: [salespersonId], references: [id])

  @@index([salespersonId, status])
  @@index([createdAt])
}

model Employee {
  id            String           @id @default(cuid())
  name          String
  department    Department
  status        EmploymentStatus @default(ACTIVE)
  presentToday  Boolean          @default(false)
  tasks         Task[]
  leaveRequests LeaveRequest[]
}

model Task {
  id         String     @id @default(cuid())
  title      String
  status     TaskStatus @default(PENDING)
  dueDate    DateTime
  completedAt DateTime?
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status, dueDate])
}

model Invoice {
  id           String        @id @default(cuid())
  customerName String
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(PENDING)
  dueDate      DateTime
  approvedAt   DateTime?

  @@index([status, dueDate])
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  status         CampaignStatus @default(ACTIVE)
  leadsGenerated Int            @default(0)
  leadSource     String
  createdAt      DateTime       @default(now())

  @@index([status])
  @@index([createdAt])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  reason     String
  employee   Employee    @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}
